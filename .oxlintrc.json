{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "node",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "sonarjs/cognitive-complexity": ["warn", 12],
    "sonarjs/cyclomatic-complexity": ["warn", { "threshold": 8 }],
    "sonarjs/nested-control-flow": ["warn", { "maximumNestingLevel": 3 }],
    "sonarjs/expression-complexity": ["warn", { "max": 3 }],
    "sonarjs/max-lines-per-function": ["warn", { "maximum": 120 }],
    "sonarjs/no-empty-test-file": "off",
    "sonarjs/fixme-tag": "off",
    "sonarjs/todo-tag": "off",
    "sonarjs/no-parameter-reassignment": "off",
    "sonarjs/prefer-while": "off",
    "sonarjs/use-type-alias": "off",
    "sonarjs/public-static-readonly": "off",
    "sonarjs/no-nested-conditional": "off",
    "sonarjs/hardcoded-secret-signatures": "off",
    "sonarjs/no-unused-vars": "off",
    "sonarjs/no-labels": "off",
    "sonarjs/no-dead-store": "off",
    "sonarjs/no-useless-catch": "off",
    "sonarjs/no-fallthrough": "off",
    "sonarjs/no-delete-var": "off",
    "sonarjs/block-scoped-var": "off",
    "sonarjs/no-nested-functions": "off",
    "sonarjs/no-empty-collection": "off",
    "sonarjs/no-commented-code": "off"
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    },
    "next": {
      "rootDir": "apps/web/"
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    }
  },
  "ignorePatterns": [
    "**/.serwist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/dist/**",
    "**/.turbo/**",
    "packages/db/prisma/generated/**",
    "packages/db/migrations/**",
    "**/*.tsbuildinfo",
    "**/*.min.*",
    "apps/web/.shadcn-cache/**",
    "apps/web/src/routeTree.gen.ts",
    ".bun/**",
    "**/.bun/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "sonarjs",
      "specifier": "./tools/oxlint/sonarjs/index.ts"
    }
  ],
  "overrides": [
    {
      "files": ["apps/web/**", "apps/web/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": [
        "apps/commerce/**",
        "apps/tenant/**",
        "apps/worker/**",
        "packages/db/**",
        "packages/api-commerce/**",
        "packages/api-tenant/**",
        "apps/orpc-server/**"
      ],
      "env": {
        "node": true,
        "builtin": true
      }
    },
    {
      // apps/web is TanStack Start, not Next: its document shell renders
      // <head> directly (HeadContent), so the Next-only rule does not apply.
      "files": ["apps/web/**"],
      "rules": {
        "nextjs/no-head-element": "off"
      }
    },
    {
      // The shared jsx-a11y `Link → a` mapping is for Next's `<Link href>`. TanStack
      // Router's `Link` takes `to` and renders the href itself, so the rule can only
      // ever see an anchor with no href — off here instead of per-line disables.
      "files": ["apps/web/**"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off"
      }
    },
    {
      "files": ["apps/web/src/components/ui/**", "apps/web/src/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      // Vendored registry code: it ships in its own shape and is not held to
      // first-party style rules. Correctness and accessibility rules stay on.
      "files": [
        "apps/web/src/components/ui/**",
        "apps/web/src/components/assistant-ui/**",
        "apps/web/src/lib/address-format.ts",
        "apps/web/src/lib/filter-params.ts",
        "apps/web/src/lib/tracking-events.ts",
        "apps/web/src/hooks/use-mobile.ts",
        "apps/web/src/hooks/use-copy-to-clipboard.ts",
        "apps/web/src/hooks/use-attachment-src.ts",
        "apps/web/src/components/ui/**",
        "apps/web/src/components/assistant-ui/**",
        "apps/web/src/components/nutrition/**",
        "apps/web/src/lib/address-format.ts",
        "apps/web/src/lib/filter-params.ts",
        "apps/web/src/lib/tracking-events.ts",
        "apps/web/src/hooks/use-mobile.ts",
        "apps/web/src/hooks/use-copy-to-clipboard.ts",
        "apps/web/src/hooks/use-attachment-src.ts"
      ],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/require-readable-spacing": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      // ReUI and SmoothUI arrive as upstream TypeScript: their public shapes,
      // dictionary types and assertion style are not first-party code, and the
      // React Compiler diagnostics describe refactors we do not make inside a
      // vendored tree. Behaviour is covered by `bun check`; the accessibility
      // and correctness rules above stay on.
      "files": [
        "apps/web/src/components/assistant-ui/**",
        "apps/web/src/lib/address-format.ts",
        "apps/web/src/lib/filter-params.ts",
        "apps/web/src/lib/tracking-events.ts",
        "apps/web/src/hooks/use-copy-to-clipboard.ts",
        "apps/web/src/hooks/use-attachment-src.ts",
        "apps/web/src/components/ui/**",
        "apps/web/src/components/assistant-ui/**",
        "apps/web/src/components/nutrition/**",
        "apps/web/src/lib/address-format.ts",
        "apps/web/src/lib/filter-params.ts",
        "apps/web/src/lib/tracking-events.ts",
        "apps/web/src/hooks/use-mobile.ts",
        "apps/web/src/hooks/use-copy-to-clipboard.ts",
        "apps/web/src/hooks/use-attachment-src.ts"
      ],
      "rules": {
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-shape-in-symbol-names": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-array-filter-map": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-reflect-get": "off",
        "react-hooks/exhaustive-deps": "off",
        "react/set-state-in-effect": "off",
        "react/refs": "off",
        "react/purity": "off",
        "react/immutability": "off",
        "react/preserve-manual-memoization": "off",
        "react/static-components": "off",
        "nextjs/no-img-element": "off"
      }
    },
    {
      // Vendored marketing blocks point at runtime image URLs (avatars, stock
      // backdrops) that a framework image component cannot size without a remote allowlist.
      "files": [],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    },
    {
      // assistant-ui vendored tree: upstream false positives (dynamic children) and intentional autoFocus/media/promise patterns — see D12.
      "files": [
        "apps/web/src/components/assistant-ui/**",
        "apps/web/src/components/assistant-ui/**"
      ],
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/heading-has-content": "off",
        "jsx-a11y/media-has-caption": "off",
        "jsx-a11y/no-autofocus": "off",
        "promise/no-callback-in-promise": "off"
      }
    },
    {
      "files": [
        "apps/web/src/components/ui/theme-toggle.tsx",
        "apps/web/src/components/push-notifications-card.tsx",
        "apps/web/src/hooks/use-mobile.ts",
        "apps/web/src/components/push-notifications-card.tsx",
        "apps/web/src/hooks/use-mobile.ts"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["apps/web/src/offline/sw-client.ts", "apps/web/tests/sync-queue.test.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "scripts/**"],
      "env": {
        "node": true,
        "bun": true
      },
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      // The import boundary of the TanStack app: a route renders on both sides,
      // so it may not reach into server-only modules. Server route handlers
      // (`export.ts`, `*.server.ts`) are the documented exception below.
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/server/*"],
                "message": "Routes render in the browser too: call a createServerFn instead of importing @/server/*."
              }
            ]
          }
        ]
      }
    },
    {
      // Server route handlers only run on the server, so they may hold a client.
      "files": ["apps/web/src/routes/**/export.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // Nothing in the web app talks to the database or the API servers directly.
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@menuza/db",
                  "@menuza/db/*",
                  "@menuza/orpc-server",
                  "@menuza/orpc-server/*",
                  "@prisma/*"
                ],
                "message": "The web app reaches the APIs over oRPC; it never imports the database or the server packages."
              }
            ]
          }
        ]
      }
    },
    {
      // Size and complexity budgets do not apply to tests. A long describe() is a
      // sequential scenario; splitting it scatters one narrative across files.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "sonarjs/max-lines-per-function": "off",
        "sonarjs/cognitive-complexity": "off",
        "sonarjs/cyclomatic-complexity": "off",
        "sonarjs/nested-control-flow": "off",
        "sonarjs/expression-complexity": "off"
      }
    }
  ]
}
