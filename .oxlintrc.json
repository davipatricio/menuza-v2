{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "node",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "sonarjs/cognitive-complexity": ["warn", 12],
    "sonarjs/cyclomatic-complexity": ["warn", { "threshold": 8 }],
    "sonarjs/nested-control-flow": ["warn", { "maximumNestingLevel": 3 }],
    "sonarjs/expression-complexity": ["warn", { "max": 3 }],
    "sonarjs/max-lines-per-function": ["warn", { "maximum": 120 }],
    "sonarjs/no-empty-test-file": "off",
    "sonarjs/fixme-tag": "off",
    "sonarjs/todo-tag": "off",
    "sonarjs/no-parameter-reassignment": "off",
    "sonarjs/prefer-while": "off",
    "sonarjs/use-type-alias": "off",
    "sonarjs/public-static-readonly": "off",
    "sonarjs/no-nested-conditional": "off",
    "sonarjs/hardcoded-secret-signatures": "off",
    "sonarjs/no-unused-vars": "off",
    "sonarjs/no-labels": "off",
    "sonarjs/no-dead-store": "off",
    "sonarjs/no-useless-catch": "off",
    "sonarjs/no-fallthrough": "off",
    "sonarjs/no-delete-var": "off",
    "sonarjs/block-scoped-var": "off",
    "sonarjs/no-nested-functions": "off",
    "sonarjs/no-empty-collection": "off",
    "sonarjs/no-commented-code": "off"
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "next": {
      "rootDir": "apps/web/"
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/dist/**",
    "**/.turbo/**",
    "packages/db/prisma/generated/**",
    "packages/db/migrations/**",
    "apps/web/.next/**",
    "**/*.tsbuildinfo",
    "**/*.min.*",
    "apps/web/.shadcn-cache/**",
    ".bun/**",
    "**/.bun/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "sonarjs",
      "specifier": "./tools/oxlint/sonarjs/index.ts"
    }
  ],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": [
        "apps/commerce/**",
        "apps/tenant/**",
        "apps/worker/**",
        "packages/db/**",
        "packages/api-commerce/**",
        "packages/api-tenant/**",
        "apps/orpc-server/**"
      ],
      "env": {
        "node": true,
        "builtin": true
      }
    },
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": ["apps/web/src/components/ui/**", "apps/web/src/hooks/use-mobile.ts"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/require-readable-spacing": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      "files": [
        "apps/web/src/components/ui/theme-toggle.tsx",
        "apps/web/src/components/push-notifications-card.tsx",
        "apps/web/src/hooks/use-mobile.ts"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["packages/offline/src/sw-client.ts", "packages/offline/tests/sync-queue.test.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "scripts/**"],
      "env": {
        "node": true,
        "bun": true
      },
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
