{
  "name": "menuza",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/contract": "2.0.0-beta.35",
      "@oxlint/plugins": "1.88.0",
      "@shopify/flash-list": "2.3.2",
      "@tanstack/query-async-storage-persister": "5.104.4",
      "@tanstack/react-query": "5.104.4",
      "@tanstack/react-query-persist-client": "5.104.4",
      "@types/react": "19.3.0",
      "babel-preset-expo": "~58.0.25",
      "bun-types": "1.4.3",
      "expo": "58.0.25",
      "expo-constants": "~58.0.16",
      "expo-font": "~58.0.12",
      "expo-haptics": "~58.0.8",
      "expo-linking": "~58.0.17",
      "expo-router": "~58.0.31",
      "expo-splash-screen": "~58.0.14",
      "expo-sqlite": "~58.0.17",
      "expo-status-bar": "~58.0.5",
      "expo-system-ui": "~58.0.7",
      "expo-updates": "~58.0.22",
      "oxfmt": "0.73.0",
      "oxlint": "1.88.0",
      "react": "19.3.1",
      "react-native": "0.88.1",
      "react-native-gesture-handler": "~3.3.0",
      "react-native-reanimated": "4.7.1",
      "react-native-safe-area-context": "~5.11.1",
      "react-native-screens": "~4.30.1",
      "react-native-worklets": "0.13.0",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "uniwind": "^1.13.2",
      "valibot": "1.5.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun --env-file-if-exists=.env run typegen && bun --env-file-if-exists=.env --filter '@menuza/web' build",
    "db:deploy": "cargo sqlx prepare --workspace -- --all-targets",
    "db:migrate": "cargo sqlx migrate run --source crates/persistence/migrations",
    "design:check": "bun run scripts/design-check.ts",
    "dev": "bun --env-file-if-exists=.env run scripts/dev.ts",
    "dev:web": "bun --env-file-if-exists=.env run --filter '@menuza/web' dev",
    "fmt": "bunx turbo run fmt --filter='@menuza/*'",
    "fmt:check": "bunx turbo run fmt:check --filter='@menuza/*'",
    "infra:down": "bun run scripts/infra-down.ts",
    "infra:up": "bun run scripts/infra-up.ts",
    "lint": "bunx turbo run lint --filter='@menuza/*'",
    "lint:fix": "bunx turbo run lint:fix --filter='@menuza/*'",
    "prepare": "husky",
    "store:build": "bun run scripts/build-store-app.ts",
    "store:update": "bun run scripts/build-store-app.ts --update",
    "test": "bun test",
    "test:integration": "bun --env-file-if-exists=.env run scripts/test-integration.ts",
    "typecheck": "bun --env-file-if-exists=.env run scripts/typecheck.ts",
    "typegen": "bun --env-file-if-exists=.env run --filter '@menuza/web' typegen"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "eas-cli": "27.10.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.11.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3 <2.0.0"
    }
  }
}
