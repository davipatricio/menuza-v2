{
  "name": "menuza",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "valibot": "1.5.0",
      "@orpc/contract": "2.0.0-beta.35",
      "oxlint": "1.88.0",
      "oxfmt": "0.73.0",
      "@oxlint/plugins": "1.88.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun --env-file-if-exists=.env run typegen && bun --env-file-if-exists=.env --filter '@menuza/web' build",
    "db:deploy": "cargo sqlx prepare --workspace -- --all-targets",
    "db:migrate": "cargo sqlx migrate run --source crates/persistence/migrations",
    "design:check": "bun run scripts/design-check.ts",
    "dev": "bun --env-file-if-exists=.env run scripts/dev.ts",
    "dev:web": "bun --env-file-if-exists=.env run --filter '@menuza/web' dev",
    "fmt": "bunx turbo run fmt --filter='@menuza/*'",
    "fmt:check": "bunx turbo run fmt:check --filter='@menuza/*'",
    "infra:down": "bun run scripts/infra-down.ts",
    "infra:up": "bun run scripts/infra-up.ts",
    "lint": "bunx turbo run lint --filter='@menuza/*'",
    "lint:fix": "bunx turbo run lint:fix --filter='@menuza/*'",
    "prepare": "husky",
    "test": "bun test",
    "test:integration": "bun --env-file-if-exists=.env run scripts/test-integration.ts",
    "typecheck": "bun --env-file-if-exists=.env run scripts/typecheck.ts",
    "typegen": "bun --env-file-if-exists=.env run --filter '@menuza/web' typegen"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.11.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3 <2.0.0"
    }
  }
}
