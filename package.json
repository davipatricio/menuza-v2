{
  "name": "menuza",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "@types/node": "22.10.5",
      "@types/bun": "1.4.1",
      "bun-types": "1.4.1",
      "@types/react": "19.2.18",
      "zod": "4.5.4",
      "@orpc/server": "1.15.0",
      "@orpc/contract": "1.15.0",
      "@tanstack/react-query": "5.102.8",
      "@tanstack/react-query-persist-client": "5.102.8",
      "@tanstack/query-persist-client-core": "5.102.8",
      "@tanstack/query-sync-storage-persister": "5.102.8",
      "idb-keyval": "6.3.0",
      "oxlint": "1.82.0",
      "oxfmt": "0.67.0",
      "@oxlint/plugins": "1.82.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun --env-file-if-exists=.env run db:generate && bun --env-file-if-exists=.env run typegen && bun --env-file-if-exists=.env --filter '@menuza/web' build",
    "db:deploy": "bun --env-file-if-exists=.env run --filter '@menuza/db' db:deploy",
    "db:generate": "bun --env-file-if-exists=.env run --filter '@menuza/db' db:generate",
    "db:migrate": "bun --env-file-if-exists=.env run --filter '@menuza/db' db:migrate",
    "db:studio": "bun --env-file-if-exists=.env run --filter '@menuza/db' db:studio",
    "dev": "bun --env-file-if-exists=.env run scripts/dev.ts",
    "dev:commerce": "bun --env-file-if-exists=.env run --filter '@menuza/commerce' dev",
    "dev:tenant": "bun --env-file-if-exists=.env run --filter '@menuza/tenant' dev",
    "dev:web": "bun --env-file-if-exists=.env run --filter '@menuza/web' dev",
    "dev:worker": "bun --env-file-if-exists=.env run --filter '@menuza/worker' dev",
    "fmt": "bunx turbo run fmt --filter='@menuza/*'",
    "fmt:check": "bunx turbo run fmt:check --filter='@menuza/*'",
    "infra:down": "bun run scripts/infra-down.ts",
    "infra:up": "bun run scripts/infra-up.ts",
    "lint": "bunx turbo run lint --filter='@menuza/*'",
    "lint:fix": "bunx turbo run lint:fix --filter='@menuza/*'",
    "test": "bun test",
    "test:integration": "bun --env-file-if-exists=.env run scripts/test-integration.ts",
    "typecheck": "bun --env-file-if-exists=.env run scripts/typecheck.ts",
    "typegen": "bun --env-file-if-exists=.env run --filter '@menuza/web' typegen"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "turbo": "2.10.12"
  },
  "packageManager": "bun@1.4.3"
}
