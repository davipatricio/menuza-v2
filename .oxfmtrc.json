{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles/globals.css"
  },
  "sortImports": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/dist/**",
    "**/.serwist/**",
    "**/.turbo/**",
    "packages/db/prisma/generated/**",
    "apps/orpc-server/openapi/**",
    "apps/web/src/routeTree.gen.ts",
    "**/*.tsbuildinfo",
    "**/*.min.*",
    ".bun/**",
    "**/.bun/**"
  ]
}
