{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/app/globals.css"
  },
  "sortImports": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/dist/**",
    "**/.turbo/**",
    "packages/db/prisma/generated/**",
    "apps/web/.next/**",
    "**/*.tsbuildinfo",
    "**/*.min.*",
    "apps/web/.shadcn-cache/**",
    ".bun/**",
    "**/.bun/**"
  ]
}
