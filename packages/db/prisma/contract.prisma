// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Tenant {
  id                String             @id(map: "Tenant_pkey")
  slug              String
  displayName       String
  createdAt         Timestamp(3)       @default(now())
  updatedAt         Timestamp(3)
  domains           Domain[]
  memberships       TenantMembership[]
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreference[]
  categories        Category[]
  subcategories     Subcategory[]
  departments       Department[]
  products          Product[]
  tags              Tag[]
  variations        Variation[]
  kits              Kit[]
  customers         Customer[]
  orders            Order[]
  coupons           Coupon[]
  auditLogs         AuditLog[]
  mealSubscriptions MealSubscription[]
  orderItems        OrderItem[]
  orderEvents       OrderEvent[]
  couponRedemptions CouponRedemption[]
  wallets           Wallet[]
  seoMeta           SeoMeta[]
  storeSettings     StoreSettings?
  storeIntegrations StoreIntegration[]
  mcpSessions       McpSession[]
  productNutritions ProductNutrition[]
  productTags       ProductTag[]
  badges            Badge[]
  productBadges     ProductBadge[]
  categoryDepartments CategoryDepartment[]
  paymentIntegrations PaymentIntegration[]
  paymentMethodAssignments PaymentMethodAssignment[]
  gatewayEvents     GatewayEvent[]

  @@index([slug], map: "Tenant_slug_key", unique: true)

  @@map("Tenant")
}

model Domain {
  id        String       @id(map: "Domain_pkey")
  host      String
  tenantId  String
  createdAt Timestamp(3) @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Domain_tenantId_fkey")

  @@index([host], map: "Domain_host_key", unique: true)
  @@index([tenantId], map: "Domain_tenantId_idx")

  @@map("Domain")
}

model Member {
  id                String             @id(map: "Member_pkey")
  email             String
  name              String?
  kind              String             @default("human")
  passwordHash      String?
  birthdate         Timestamp(3)?
  createdAt         Timestamp(3)       @default(now())
  updatedAt         Timestamp(3)
  sessions          Session[]
  memberships       TenantMembership[]
  identities        MemberIdentity[]
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreference[]
  onboarding        MemberOnboarding?

  @@index([email], map: "Member_email_key", unique: true)

  @@map("Member")
}

model MemberIdentity {
  id                String        @id(map: "MemberIdentity_pkey")
  memberId          String
  provider          String
  providerAccountId String
  createdAt         Timestamp(3) @default(now())
  member            Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MemberIdentity_memberId_fkey")

  @@index([provider, providerAccountId], map: "MemberIdentity_provider_providerAccountId_key", unique: true)
  @@index([memberId], map: "MemberIdentity_memberId_idx")

  @@map("MemberIdentity")
}

model Session {
  id         String        @id(map: "Session_pkey")
  memberId   String
  namespace  String
  expiresAt  Timestamp(3)
  revokedAt  Timestamp(3)?
  createdAt  Timestamp(3)  @default(now())
  lastUsedAt Timestamp(3)  @default(now())
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Session_memberId_fkey")

  @@index([memberId], map: "Session_memberId_idx")
  @@index([expiresAt], map: "Session_expiresAt_idx")

  @@map("Session")
}

model TenantMembership {
  id        String       @id(map: "TenantMembership_pkey")
  memberId  String
  tenantId  String
  role      String
  createdAt Timestamp(3) @default(now())
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TenantMembership_memberId_fkey")
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TenantMembership_tenantId_fkey")

  @@index([memberId, tenantId], map: "TenantMembership_memberId_tenantId_key", unique: true)
  @@index([tenantId], map: "TenantMembership_tenantId_idx")

  @@map("TenantMembership")
}

model PushSubscription {
  id             String        @id(map: "PushSubscription_pkey")
  tenantId       String
  memberId       String
  endpoint       String
  p256dh         String
  auth           String
  expirationTime Timestamp(3)?
  createdAt      Timestamp(3)  @default(now())
  updatedAt      Timestamp(3)
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushSubscription_memberId_fkey")
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushSubscription_tenantId_fkey")

  @@index([endpoint], map: "PushSubscription_endpoint_key", unique: true)
  @@index([tenantId, memberId], map: "PushSubscription_tenantId_memberId_idx")
  @@index([tenantId], map: "PushSubscription_tenantId_idx")

  @@map("PushSubscription")
}

model PushPreference {
  id        String       @id(map: "PushPreference_pkey")
  tenantId  String
  memberId  String
  event     String
  createdAt Timestamp(3) @default(now())
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushPreference_memberId_fkey")
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushPreference_tenantId_fkey")

  @@index([tenantId, memberId, event], map: "PushPreference_tenantId_memberId_event_key", unique: true)
  @@index([tenantId], map: "PushPreference_tenantId_idx")

  @@map("PushPreference")
}

// Signup onboarding survey (MEN-225). Member-level, not tenant-scoped: the
// answers describe the person, not a store. `persona` required, the rest are
// filled only when the member chose to answer them.
model MemberOnboarding {
  id          String       @id(map: "MemberOnboarding_pkey")
  memberId    String
  persona     String
  segment     String?
  referral    String?
  completedAt Timestamp(3)
  createdAt   Timestamp(3) @default(now())
  updatedAt   Timestamp(3)
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MemberOnboarding_memberId_fkey")

  @@unique([memberId], map: "MemberOnboarding_memberId_key")

  @@map("MemberOnboarding")
}

// --- Commerce base models (MEN-225) -----------------------------------------
//
// The floor the panel pages stand on: catalog, customers, orders, coupons and
// the audit trail. Every model here is tenant-scoped, so `TENANT_SCOPED_MODELS`
// (derived from this contract) picks each one up automatically and every query
// must carry an explicit `where.tenantId`.
//
// Money is `Int` cents (ADR-0006): BRL has no sub-cent unit, so a Decimal column
// would buy nothing and would drag Decimal/Temporal into every read. Enums are
// stored as `pg/text@1` with a planner-generated CHECK; the values are stable
// lowercase ASCII and the pt-BR labels live only in the UI.

enum stock_mode {
  @@type("pg/text@1")

  controlled
  unlimited
}

enum kit_mode {
  @@type("pg/text@1")

  preselected
  build_your_own
}

enum financial_status {
  @@type("pg/text@1")

  pending
  awaiting_payment
  pending_on_delivery
  paid
  refunded
  expired
  canceled
}

enum fulfilment_status {
  @@type("pg/text@1")

  pending
  confirmed
  preparing
  ready
  ready_for_pickup
  out_for_delivery
  completed
  canceled
}

enum payment_method {
  @@type("pg/text@1")

  pix
  credit
  debit
  meal_voucher
  food_voucher
  boleto
  cash_on_delivery
  card_on_delivery
}

// Which adapter handles a gateway connection. `offline` is the manual one: the
// store reconciles the payment itself, no API and no credentials are involved.
enum payment_provider {
  @@type("pg/text@1")

  pagarme
  offline
}

enum payment_integration_status {
  @@type("pg/text@1")

  active
  disabled
}

// Per-store integration switch. `error` and `paused` are states the catalog's
// own checks put a store into (a broken credential, a paused sync); the
// platform never guesses at them.
enum integration_status {
  @@type("pg/text@1")

  enabled
  disabled
  paused
  error
}

// A received provider callback. `received` means it is persisted but the order
// has not been touched yet; the worker moves it to one of the rest.
enum gateway_event_status {
  @@type("pg/text@1")

  received
  processed
  ignored
  rejected
  failed
}

enum order_event_type {
  @@type("pg/text@1")

  financial_changed
  fulfilment_changed
  payment_recorded
  refunded
  cashback_credited
  cashback_reversed
  wallet_reserved
  wallet_released
  note
}

enum wallet_transaction_kind {
  @@type("pg/text@1")

  cashback_credit
  store_credit
  reserve
  reserve_release
  spend
  reversal
  adjustment
}

enum seo_entity_type {
  @@type("pg/text@1")

  store
  department
  category
  tag
  product
  kit
  coupon
}

enum discount_type {
  @@type("pg/text@1")

  percentage
  fixed
}

enum coupon_status {
  @@type("pg/text@1")

  active
  expired
  disabled
}

enum meal_cadence {
  @@type("pg/text@1")

  weekly
  monthly
}

enum meal_subscription_status {
  @@type("pg/text@1")

  active
  paused
  canceled
}

// How a nutrition label is measured and drawn. `simplified` is the IN 75
// declaracao simplificada: non-significant constituents leave the grid and are
// named in the legal sentence below it.
enum nutrition_basis {
  @@type("pg/text@1")

  solid
  liquid
}

enum nutrition_label_format {
  @@type("pg/text@1")

  vertical
  simplified
}

enum nutrition_source {
  @@type("pg/text@1")

  manual
  lab
  supplier_label
  database
  estimate
}

// Named group of a tenant's catalog. `sortOrder` drives the panel's listing.
// A category belongs to zero or more departments; products live one level
// deeper, under a Subcategory.
model Category {
  id            String               @id(map: "Category_pkey")
  tenantId      String
  name          String
  sortOrder     Int                  @default(0)
  active        Boolean              @default(true)
  updatedAt     Timestamp(3)         @default(now())
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Category_tenantId_fkey")
  subcategories Subcategory[]
  departments   CategoryDepartment[]

  @@unique([tenantId, name], map: "Category_tenantId_name_key")
  @@index([tenantId], map: "Category_tenantId_idx")

  @@map("Category")
}

// A category inside a category: the level products actually attach to.
model Subcategory {
  id         String       @id(map: "Subcategory_pkey")
  tenantId   String
  categoryId String
  name       String
  sortOrder  Int          @default(0)
  active     Boolean      @default(true)
  updatedAt  Timestamp(3) @default(now())
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subcategory_tenantId_fkey")
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Subcategory_categoryId_fkey")
  products   Product[]

  @@unique([categoryId, name], map: "Subcategory_categoryId_name_key")
  @@index([tenantId], map: "Subcategory_tenantId_idx")
  @@index([categoryId], map: "Subcategory_categoryId_idx")

  @@map("Subcategory")
}

// A sellable item. It carries no price: the money lives on the Variation, so a
// product with a single default variation and a product with a real variant
// matrix share one table.
model Department {
  id         String               @id(map: "Department_pkey")
  tenantId   String
  name       String
  // `active` is panel state; no query filters on it yet.
  active     Boolean              @default(true)
  updatedAt  Timestamp(3)         @default(now())
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Department_tenantId_fkey")
  categories CategoryDepartment[]

  @@unique([tenantId, name], map: "Department_tenantId_name_key")
  @@index([tenantId], map: "Department_tenantId_idx")

  @@map("Department")
}

// Which departments a category appears under. A plain join row, exactly like
// ProductTag: composite primary key, one extra index on the second column.
//
// The join carries the tenant it belongs to, so the isolation guard checks it
// like any other tenant-scoped model. The composite key stays on the two
// parents — a category reaches a department once — and a trigger rejects a row
// whose parents do not share the tenant, because a foreign key cannot say
// "these two columns belong to the same tenant" on its own.
model CategoryDepartment {
  tenantId     String
  categoryId   String
  departmentId String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CategoryDepartment_tenantId_fkey")
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CategoryDepartment_categoryId_fkey")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CategoryDepartment_departmentId_fkey")

  @@id([categoryId, departmentId], map: "CategoryDepartment_pkey")
  @@index([departmentId], map: "CategoryDepartment_departmentId_idx")
  @@index([tenantId], map: "CategoryDepartment_tenantId_idx")

  @@map("CategoryDepartment")
}

model Tag {
  id        String       @id(map: "Tag_pkey")
  tenantId  String
  name      String
  isActive  Boolean      @default(true)
  updatedAt Timestamp(3) @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Tag_tenantId_fkey")
  products  ProductTag[]

  @@unique([tenantId, name], map: "Tag_tenantId_name_key")
  @@index([tenantId], map: "Tag_tenantId_idx")

  @@map("Tag")
}

model Badge {
  id        String         @id(map: "Badge_pkey")
  tenantId  String
  name      String
  imageUrl  String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  updatedAt Timestamp(3)   @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Badge_tenantId_fkey")
  products  ProductBadge[]

  @@unique([tenantId, name], map: "Badge_tenantId_name_key")
  @@index([tenantId], map: "Badge_tenantId_idx")
  @@map("Badge")
}

model Product {
  id            String        @id(map: "Product_pkey")
  tenantId      String
  name          String
  description   String?
  imageUrl      String?
  subcategoryId String?
  available     Boolean       @default(true)
  archived      Boolean       @default(false)
  hidden        Boolean       @default(false)
  private       Boolean       @default(false)
  sortOrder     Int           @default(0)
  updatedAt     Timestamp(3)  @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Product_tenantId_fkey")
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Product_subcategoryId_fkey")
  variations    Variation[]
  tags          ProductTag[]
  badges        ProductBadge[]
  orderItems    OrderItem[]
  nutrition     ProductNutrition?

  @@index([tenantId], map: "Product_tenantId_idx")
  @@index([subcategoryId], map: "Product_subcategoryId_idx")

  @@map("Product")
}

// A selectable variant with its own price and stock. Products without a real
// variant matrix still get one row, named "default" (MEN-80/81).
model Variation {
  id         String   @id(map: "Variation_pkey")
  tenantId   String
  productId  String
  name       String
  priceCents Int
  stockMode  stock_mode
  // Null exactly when `stockMode` is `unlimited`; the check below says so.
  stockQty   Int?
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Variation_tenantId_fkey")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Variation_productId_fkey")
  kitItems   KitItem[]
  orderItems OrderItem[]

  @@unique([productId, name], map: "Variation_productId_name_key")
  @@index([tenantId], map: "Variation_tenantId_idx")

  @@check(expression: sql`"priceCents" >= 0`, name: "variation_price_non_negative")
  @@check(
    expression: sql`"stockQty" IS NULL OR "stockQty" >= 0`,
    name: "variation_stock_non_negative"
  )
  // `stockQty` is the controlled stock and `null` means unlimited, so the
  // column and the mode have to agree: an unlimited variation carries no
  // quantity and a controlled one always carries one.
  @@check(
    expression: sql`("stockMode" = 'unlimited' AND "stockQty" IS NULL) OR ("stockMode" = 'controlled' AND "stockQty" IS NOT NULL)`,
    name: "variation_stock_mode_consistent"
  )

  @@map("Variation")
}

// A product's tags. Like CategoryDepartment, the join carries its tenant so
// the isolation guard checks it; a trigger rejects a row whose product and
// tag do not share that tenant.
model ProductTag {
  tenantId  String
  productId String
  tagId     String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductTag_tenantId_fkey")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductTag_productId_fkey")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductTag_tagId_fkey")

  @@id([productId, tagId], map: "ProductTag_pkey")
  @@index([tagId], map: "ProductTag_tagId_idx")
  @@index([tenantId], map: "ProductTag_tenantId_idx")

  @@map("ProductTag")
}

model ProductBadge {
  tenantId  String
  productId String
  badgeId   String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductBadge_tenantId_fkey")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductBadge_productId_fkey")
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductBadge_badgeId_fkey")

  @@id([productId, badgeId], map: "ProductBadge_pkey")
  @@index([badgeId], map: "ProductBadge_badgeId_idx")
  @@index([tenantId], map: "ProductBadge_tenantId_idx")
  @@map("ProductBadge")
}

// A sellable bundle of variations (MEN-82). The pricing formula is still open
// (PRODUCT.md §7), so a kit has no price column of its own here.
model Kit {
  id        String   @id(map: "Kit_pkey")
  tenantId  String
  name      String
  mode      kit_mode
  available Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Kit_tenantId_fkey")
  items     KitItem[]
  orderItems OrderItem[]

  @@index([tenantId], map: "Kit_tenantId_idx")

  @@map("Kit")
}

// Kit -> Variation, never to a Product: a kit debits the variation it names
// (MEN-83), and the variation is where stock lives.
model KitItem {
  id          String    @id(map: "KitItem_pkey")
  tenantId    String
  kitId       String
  variationId String
  quantity    Int
  kit         Kit       @relation(fields: [kitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "KitItem_kitId_fkey")
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "KitItem_variationId_fkey")

  @@unique([kitId, variationId], map: "KitItem_kitId_variationId_key")
  @@index([tenantId], map: "KitItem_tenantId_idx")
  @@index([variationId], map: "KitItem_variationId_idx")

  @@check(expression: sql`"quantity" > 0`, name: "kit_item_quantity_positive")

  @@map("KitItem")
}

// A person buying from a store. Deliberately NOT a Member: buyers have no
// panel access and their own auth arrives with MEN-76/MEN-214.
model Customer {
  id       String   @id(map: "Customer_pkey")
  tenantId String
  name     String
  email    String
  phone    String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Customer_tenantId_fkey")
  orders             Order[]
  mealSubscriptions MealSubscription[]
  redemptions        CouponRedemption[]
  wallets            Wallet[]

  @@unique([tenantId, email], map: "Customer_tenantId_email_key")
  @@index([tenantId], map: "Customer_tenantId_idx")

  @@map("Customer")
}

// A purchase belonging to a single tenant, never split across deliveries. The
// two status axes are independent (MEN-93 split the old `status`): money and
// fulfilment move on their own timelines, so one column cannot describe both.
// Money is Int cents and `totalCents` is the arithmetic sum of the other
// columns, enforced by the check below.
model Order {
  id                 String             @id(map: "Order_pkey")
  tenantId           String
  code               String
  customerId         String
  subtotalCents      Int
  discountCents      Int                @default(0)
  shippingCents      Int                @default(0)
  walletAppliedCents Int                @default(0)
  cashbackCents      Int                @default(0)
  totalCents         Int
  financialStatus    financial_status
  fulfilmentStatus   fulfilment_status
  paymentMethod      payment_method?
  paidAt             Timestamp(3)?
  expiresAt          Timestamp(3)?
  couponId           String?
  createdAt          Timestamp(3)       @default(now())
  updatedAt          Timestamp(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Order_tenantId_fkey")
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Order_customerId_fkey")
  coupon             Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Order_couponId_fkey")
  items              OrderItem[]
  events             OrderEvent[]
  redemptions        CouponRedemption[]
  walletTransactions WalletTransaction[]

  @@unique([tenantId, code], map: "Order_tenantId_code_key")
  @@index([tenantId], map: "Order_tenantId_idx")
  @@index([customerId], map: "Order_customerId_idx")

  @@check(expression: sql`"subtotalCents" >= 0`, name: "order_subtotal_non_negative")
  @@check(expression: sql`"discountCents" >= 0`, name: "order_discount_non_negative")
  @@check(expression: sql`"shippingCents" >= 0`, name: "order_shipping_non_negative")
  @@check(expression: sql`"walletAppliedCents" >= 0`, name: "order_wallet_applied_non_negative")
  @@check(expression: sql`"cashbackCents" >= 0`, name: "order_cashback_non_negative")
  @@check(expression: sql`"totalCents" >= 0`, name: "order_total_non_negative")
  // The money identity of an order: what the buyer pays is the merchandise,
  // minus the discounts, plus the freight, minus what the wallet covered.
  // `cashbackCents` is earned, never subtracted, so it stays out of it.
  @@check(
    expression: sql`"totalCents" = "subtotalCents" - "discountCents" + "shippingCents" - "walletAppliedCents"`,
    name: "order_total_matches_lines"
  )

  @@map("Order")
}

// One line of an order. The name and the prices are copied at checkout time:
// the catalog row may be renamed, repriced or deleted later, and the order must
// keep showing what was actually bought.
model OrderItem {
  id             String     @id(map: "OrderItem_pkey")
  tenantId       String
  orderId        String
  productId      String?
  variationId    String?
  kitId          String?
  name           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  optionsLabel   String?
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderItem_tenantId_fkey")
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderItem_orderId_fkey")
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "OrderItem_productId_fkey")
  variation      Variation? @relation(fields: [variationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "OrderItem_variationId_fkey")
  kit            Kit?       @relation(fields: [kitId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "OrderItem_kitId_fkey")

  @@index([tenantId], map: "OrderItem_tenantId_idx")
  @@index([orderId], map: "OrderItem_orderId_idx")

  @@check(expression: sql`"quantity" > 0`, name: "order_item_quantity_positive")
  @@check(expression: sql`"lineTotalCents" >= 0`, name: "order_item_line_total_non_negative")

  @@map("OrderItem")
}

// Append-only trail of one order's status and money transitions. Nothing
// updates or deletes a row here; an undo is another event. `fromValue` /
// `toValue` carry the slugs of whichever axis the `type` names.
model OrderEvent {
  id            String           @id(map: "OrderEvent_pkey")
  tenantId      String
  orderId       String
  type          order_event_type
  fromValue     String?
  toValue       String?
  actorMemberId String?
  reason        String?
  detail        String?
  createdAt     Timestamp(3)     @default(now())
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderEvent_tenantId_fkey")
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OrderEvent_orderId_fkey")

  @@index([tenantId], map: "OrderEvent_tenantId_idx")
  @@index([orderId], map: "OrderEvent_orderId_idx")

  @@map("OrderEvent")
}

// A coupon actually used on an order, one row per (coupon, order). The two
// uniques are what `Coupon.usageCount` and the per-customer limit are counted
// from, so they are constraints rather than code.
model CouponRedemption {
  id            String   @id(map: "CouponRedemption_pkey")
  tenantId      String
  couponId      String
  orderId       String
  customerId    String
  discountCents Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CouponRedemption_tenantId_fkey")
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CouponRedemption_couponId_fkey")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CouponRedemption_orderId_fkey")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CouponRedemption_customerId_fkey")

  @@unique([couponId, orderId], map: "CouponRedemption_couponId_orderId_key")
  @@unique([couponId, customerId], map: "CouponRedemption_couponId_customerId_key")
  @@index([tenantId], map: "CouponRedemption_tenantId_idx")

  @@map("CouponRedemption")
}

// A customer's store credit and cashback balance, one wallet per customer per
// tenant. `balanceCents` is the running total of `WalletTransaction` rows.
model Wallet {
  id           String              @id(map: "Wallet_pkey")
  tenantId     String
  customerId   String
  balanceCents Int                 @default(0)
  createdAt    Timestamp(3)        @default(now())
  updatedAt    Timestamp(3)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Wallet_tenantId_fkey")
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Wallet_customerId_fkey")
  transactions WalletTransaction[]

  @@unique([tenantId, customerId], map: "Wallet_tenantId_customerId_key")
  @@index([tenantId], map: "Wallet_tenantId_idx")

  @@check(expression: sql`"balanceCents" >= 0`, name: "wallet_balance_non_negative")

  @@map("Wallet")
}

// One movement of a wallet. `amountCents` is signed — a credit is positive, a
// spend, reserve or reversal is negative — so the column is the ledger and
// `Wallet.balanceCents` is its rollup.
model WalletTransaction {
  id            String                 @id(map: "WalletTransaction_pkey")
  tenantId      String
  walletId      String
  orderId       String?
  kind          wallet_transaction_kind
  amountCents   Int
  actorMemberId String?
  reason        String?
  createdAt     Timestamp(3)           @default(now())
  wallet        Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "WalletTransaction_walletId_fkey")
  order         Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "WalletTransaction_orderId_fkey")

  @@index([walletId], map: "WalletTransaction_walletId_idx")
  @@index([tenantId], map: "WalletTransaction_tenantId_idx")

  @@map("WalletTransaction")
}

// Per-entity SEO overrides. `jsonLd` is stored as text because the structured
// data is authored/derived as JSON and never queried by field.
model SeoMeta {
  id             String          @id(map: "SeoMeta_pkey")
  tenantId       String
  entityType     seo_entity_type
  entityId       String
  title          String?
  description    String?
  canonicalUrl   String?
  socialImageUrl String?
  jsonLd         String?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "SeoMeta_tenantId_fkey")

  @@unique([tenantId, entityType, entityId], map: "SeoMeta_tenantId_entityType_entityId_key")
  @@index([tenantId], map: "SeoMeta_tenantId_idx")

  @@map("SeoMeta")
}

// One nutrition label per product (1:1). Values are stored per 100 g
// (`solid`) or 100 mL (`liquid`), in the smallest unit the label declares:
// kcal for energy, milligrams for nutrients and thousandths of a gram/mL for
// the portion. Portion, %VD and the front-of-pack alerts are always derived,
// never stored. The three `showHigh*` flags are the store's explicit choice:
// a threshold being met makes the alert recommended, not automatic.
model ProductNutrition {
  id                  String                 @id(map: "ProductNutrition_pkey")
  tenantId            String
  productId           String                 @unique(map: "ProductNutrition_productId_key")
  basis               nutrition_basis        @default(solid)
  labelFormat         nutrition_label_format @default(vertical)
  source              nutrition_source       @default(manual)
  referenceAt         Timestamp(3)?
  energyKcal          Int?
  carbsMg             Int?
  totalSugarsMg       Int?
  addedSugarsMg       Int?
  proteinMg           Int?
  totalFatMg          Int?
  saturatedFatMg      Int?
  transFatMg          Int?
  fiberMg             Int?
  sodiumMg            Int?
  portionMilli        Int?
  householdMeasure    String?
  servingsPerPack     Int?
  showHighAddedSugar  Boolean                @default(false)
  showHighSatFat      Boolean                @default(false)
  showHighSodium      Boolean                @default(false)
  published           Boolean                @default(false)
  notes               String?
  createdAt           Timestamp(3)           @default(now())
  updatedAt           Timestamp(3)           @default(now())
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductNutrition_tenantId_fkey")
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductNutrition_productId_fkey")

  @@index([tenantId], map: "ProductNutrition_tenantId_idx")

  @@check(expression: sql`"energyKcal" IS NULL OR "energyKcal" >= 0`, name: "product_nutrition_energy_non_negative")
  @@check(expression: sql`"carbsMg" IS NULL OR "carbsMg" >= 0`, name: "product_nutrition_carbs_non_negative")
  @@check(expression: sql`"totalSugarsMg" IS NULL OR "totalSugarsMg" >= 0`, name: "product_nutrition_total_sugars_non_negative")
  @@check(expression: sql`"addedSugarsMg" IS NULL OR "addedSugarsMg" >= 0`, name: "product_nutrition_added_sugars_non_negative")
  @@check(expression: sql`"proteinMg" IS NULL OR "proteinMg" >= 0`, name: "product_nutrition_protein_non_negative")
  @@check(expression: sql`"totalFatMg" IS NULL OR "totalFatMg" >= 0`, name: "product_nutrition_total_fat_non_negative")
  @@check(expression: sql`"saturatedFatMg" IS NULL OR "saturatedFatMg" >= 0`, name: "product_nutrition_saturated_fat_non_negative")
  @@check(expression: sql`"transFatMg" IS NULL OR "transFatMg" >= 0`, name: "product_nutrition_trans_fat_non_negative")
  @@check(expression: sql`"fiberMg" IS NULL OR "fiberMg" >= 0`, name: "product_nutrition_fiber_non_negative")
  @@check(expression: sql`"sodiumMg" IS NULL OR "sodiumMg" >= 0`, name: "product_nutrition_sodium_non_negative")
  @@check(expression: sql`"portionMilli" IS NULL OR "portionMilli" > 0`, name: "product_nutrition_portion_positive")
  @@check(expression: sql`"servingsPerPack" IS NULL OR "servingsPerPack" > 0`, name: "product_nutrition_servings_positive")
  @@check(expression: sql`"addedSugarsMg" IS NULL OR "totalSugarsMg" IS NULL OR "addedSugarsMg" <= "totalSugarsMg"`, name: "product_nutrition_added_sugars_lte_total")
  @@check(expression: sql`"saturatedFatMg" IS NULL OR "transFatMg" IS NULL OR "totalFatMg" IS NULL OR "saturatedFatMg" + "transFatMg" <= "totalFatMg"`, name: "product_nutrition_fat_sum")

  @@map("ProductNutrition")
}

// Store-level settings that are one row per tenant (SEO templates today).
model StoreSettings {
  id                     String       @id(map: "StoreSettings_pkey")
  tenantId               String
  seoTitleTemplate       String?
  seoDescriptionTemplate String?
  seoSocialImageUrl      String?
  createdAt              Timestamp(3) @default(now())
  updatedAt              Timestamp(3)
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StoreSettings_tenantId_fkey")

  @@unique([tenantId], map: "StoreSettings_tenantId_key")

  @@map("StoreSettings")
}

// A gateway connection a store owns. `provider` picks the adapter that speaks
// to it; `offline` is the manual one: no credentials, no API, no webhook — the
// store reconciles the payment itself. `credentials` is AES-256-GCM ciphertext
// of a provider-shaped JSON blob: it is written by the panel and read by the
// adapter, and no read path, log or export may ever return it.
model PaymentIntegration {
  id           String                     @id(map: "PaymentIntegration_pkey")
  tenantId     String
  provider     payment_provider
  label        String
  status       payment_integration_status @default(active)
  credentials  String?
  // Opaque random secret that identifies this integration in the callback URL.
  // Unique across the whole table so the receiver can resolve it without
  // knowing the tenant yet.
  webhookToken String
  createdAt    Timestamp(3)               @default(now())
  updatedAt    Timestamp(3)
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PaymentIntegration_tenantId_fkey")
  assignments  PaymentMethodAssignment[]
  events       GatewayEvent[]

  @@unique([webhookToken], map: "PaymentIntegration_webhookToken_key")
  @@index([tenantId], map: "PaymentIntegration_tenantId_idx")

  @@map("PaymentIntegration")
}

// Which provider handles which payment method for one store. One row per
// (tenant, method): providers are per method, and there is no automatic
// routing between two providers of the same method.
model PaymentMethodAssignment {
  id            String             @id(map: "PaymentMethodAssignment_pkey")
  tenantId      String
  method        payment_method
  integrationId String
  createdAt     Timestamp(3)       @default(now())
  updatedAt     Timestamp(3)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PaymentMethodAssignment_tenantId_fkey")
  integration   PaymentIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PaymentMethodAssignment_integrationId_fkey")

  @@unique([tenantId, method], map: "PaymentMethodAssignment_tenantId_method_key")
  @@index([tenantId], map: "PaymentMethodAssignment_tenantId_idx")
  @@index([integrationId], map: "PaymentMethodAssignment_integrationId_idx")

  @@map("PaymentMethodAssignment")
}

// One received provider callback. The unique on (tenant, provider, externalId)
// is what turns a provider replay into a no-op; the worker then applies the
// event to the order exactly once.
model GatewayEvent {
  id            String              @id(map: "GatewayEvent_pkey")
  tenantId      String
  integrationId String
  provider      payment_provider
  externalId    String
  type          String
  orderCode     String?
  amountCents   Int?
  status        gateway_event_status @default(received)
  detail        String?
  receivedAt    Timestamp(3)        @default(now())
  processedAt   Timestamp(3)?
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "GatewayEvent_tenantId_fkey")
  integration   PaymentIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "GatewayEvent_integrationId_fkey")

  @@unique([tenantId, provider, externalId], map: "GatewayEvent_tenantId_provider_externalId_key")
  @@index([tenantId], map: "GatewayEvent_tenantId_idx")
  @@index([integrationId], map: "GatewayEvent_integrationId_idx")

  @@map("GatewayEvent")
}

// A store-configured discount. `value` is cents when `discountType` is `fixed`
// and a whole percent when it is `percentage`; eligibility and stacking rules
// are MEN-97, so there are none here.
model Coupon {
  id           String        @id(map: "Coupon_pkey")
  tenantId     String
  code         String
  discountType discount_type
  value        Int
  description  String?
  usageCount   Int           @default(0)
  status       coupon_status @default(active)
  usageLimit   Int?
  perCustomerLimit Int?
  minimumOrderCents Int?
  maximumDiscountCents Int?
  shippingDiscountPercent Int?
  startsAt     Timestamp(3)?
  endsAt       Timestamp(3)?
  stackable    Boolean       @default(false)
  firstPurchaseOnly Boolean  @default(false)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Coupon_tenantId_fkey")
  orders       Order[]
  redemptions  CouponRedemption[]

  @@unique([tenantId, code], map: "Coupon_tenantId_code_key")
  @@index([tenantId], map: "Coupon_tenantId_idx")

  // `value` carries cents for a fixed discount and a whole percent for a
  // percentage one, so a percentage can never exceed 100 and neither form can
  // be negative. Every limit is a count of uses or an amount of money, never
  // zero — zero would mean "never applies".
  @@check(expression: sql`"value" >= 0`, name: "coupon_value_non_negative")
  @@check(
    expression: sql`"discountType" <> 'percentage' OR "value" <= 100`,
    name: "coupon_percentage_within_hundred"
  )
  @@check(
    expression: sql`"usageLimit" IS NULL OR "usageLimit" > 0`,
    name: "coupon_usage_limit_positive"
  )
  @@check(
    expression: sql`"perCustomerLimit" IS NULL OR "perCustomerLimit" > 0`,
    name: "coupon_per_customer_limit_positive"
  )
  @@check(
    expression: sql`"minimumOrderCents" IS NULL OR "minimumOrderCents" >= 0`,
    name: "coupon_minimum_order_non_negative"
  )
  @@check(
    expression: sql`"maximumDiscountCents" IS NULL OR "maximumDiscountCents" >= 0`,
    name: "coupon_maximum_discount_non_negative"
  )
  @@check(
    expression: sql`"shippingDiscountPercent" IS NULL OR ("shippingDiscountPercent" >= 0 AND "shippingDiscountPercent" <= 100)`,
    name: "coupon_shipping_discount_within_hundred"
  )

  @@map("Coupon")
}

// Append-only trail: who (actor) did what (action) to what (target), from
// where (ip), when (createdAt). `action` is free text on purpose — MEN-74 owns
// the closed event catalog.
model AuditLog {
  id        String     @id(map: "AuditLog_pkey")
  tenantId  String
  action    String
  actor     String
  target    String
  ip        String
  createdAt Timestamp(3) @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AuditLog_tenantId_fkey")

  @@index([tenantId], map: "AuditLog_tenantId_idx")

  @@map("AuditLog")
}

// Meal subscription (CONTEXT.md: recurring purchase of meals by a customer, not
// the SaaS contract). A structural stub only: PRODUCT.md §19/§22 put recurring
// meals after the MVP and MEN-150 still owns cadence charging, pausing, failure
// handling and stock reservation. No items and no `nextChargeAt` here, so the
// column set is a dead end until that ticket lands — it exists so the FK from a
// customer to a recurring plan is not invented later.
model MealSubscription {
  id         String                   @id(map: "MealSubscription_pkey")
  tenantId   String
  customerId String
  cadence    meal_cadence
  status     meal_subscription_status
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MealSubscription_tenantId_fkey")
  customer   Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MealSubscription_customerId_fkey")

  @@index([tenantId], map: "MealSubscription_tenantId_idx")
  @@index([customerId], map: "MealSubscription_customerId_idx")

  @@map("MealSubscription")
}

model OAuthClient {
  id               String          @id(map: "OAuthClient_pkey")
  clientId         String
  clientSecretHash String?
  name             String
  redirectUris     String[]
  isPublic         Boolean         @default(true)
  createdAt        Timestamp(3)    @default(now())
  tokens           OAuthToken[]
  authCodes        OAuthAuthCode[]

  @@index([clientId], map: "OAuthClient_clientId_key", unique: true)
  @@map("OAuthClient")
}

model OAuthAuthCode {
  id                  String       @id(map: "OAuthAuthCode_pkey")
  codeHash            String
  clientId            String
  memberId            String
  codeChallenge       String
  codeChallengeMethod String
  tenantIds           String[]
  scopes              String[]
  redirectUri         String
  expiresAt           Timestamp(3)
  createdAt           Timestamp(3) @default(now())
  client              OAuthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade, map: "OAuthAuthCode_clientId_fkey")

  @@index([codeHash], map: "OAuthAuthCode_codeHash_key", unique: true)
  @@index([expiresAt], map: "OAuthAuthCode_expiresAt_idx")
  @@map("OAuthAuthCode")
}

model OAuthToken {
  id               String        @id(map: "OAuthToken_pkey")
  accessTokenHash  String
  refreshTokenHash String?
  clientId         String
  memberId         String
  tenantIds        String[]
  scopes           String[]
  expiresAt        Timestamp(3)
  revokedAt        Timestamp(3)?
  createdAt        Timestamp(3)  @default(now())
  client           OAuthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade, map: "OAuthToken_clientId_fkey")

  @@index([accessTokenHash], map: "OAuthToken_accessTokenHash_key", unique: true)
  @@index([refreshTokenHash], map: "OAuthToken_refreshTokenHash_key", unique: true)
  @@index([expiresAt], map: "OAuthToken_expiresAt_idx")
  @@map("OAuthToken")
}

// One store's switch for one catalog integration (MCP today; GA4, Meta Pixel,
// Lalamove and the rest later). The catalog itself lives in code — an
// integration exists because a module ships, not because a row does — so this
// table is only per-store state: is it on, and what did the store configure.
//
// `config` is opaque JSON: each integration module owns its own shape and
// validates it on read, which keeps adding an integration from changing the
// schema.
model StoreIntegration {
  id            String             @id(map: "StoreIntegration_pkey")
  tenantId      String
  // Catalog id from the integration modules, e.g. "mcp-dashboard".
  integrationId String
  status        integration_status @default(disabled)
  config        String?
  enabledAt     Timestamp(3)?
  createdAt     Timestamp(3)       @default(now())
  updatedAt     Timestamp(3)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StoreIntegration_tenantId_fkey")

  @@unique([tenantId, integrationId], map: "StoreIntegration_tenantId_integrationId_key")
  @@index([tenantId], map: "StoreIntegration_tenantId_idx")
  @@map("StoreIntegration")
}

// A connected MCP client session: one row per "Conectar" a member completed.
// Several members (and one member on two machines) hold sessions at once, so
// this is the store-facing handle an admin can list and revoke by name; the
// credential itself stays in `OAuthToken`, and `oauthTokenId` links the two.
model McpSession {
  id            String        @id(map: "McpSession_pkey")
  tenantId      String
  memberId      String
  integrationId String
  // Human label shown in the sessions list ("Claude Code — notebook").
  label         String
  clientName    String
  oauthTokenId  String
  tokenDigest   String
  lastUsedAt    Timestamp(3)?
  revokedAt     Timestamp(3)?
  createdAt     Timestamp(3)  @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "McpSession_tenantId_fkey")

  @@index([tenantId, integrationId], map: "McpSession_tenantId_integrationId_idx")
  @@index([memberId], map: "McpSession_memberId_idx")
  @@index([tokenDigest], map: "McpSession_tokenDigest_key", unique: true)
  @@map("McpSession")
}
