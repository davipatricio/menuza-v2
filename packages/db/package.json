{
  "name": "@menuza/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:deploy": "prisma db migrate",
    "db:emit": "prisma contract emit",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma migration plan",
    "db:seed": "bun run prisma/seed.ts",
    "db:verify": "prisma db verify",
    "fmt": "oxfmt . \"!migrations/**\"",
    "fmt:check": "oxfmt --check . \"!migrations/**\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@menuza/tenant-context": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.11.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prisma": "8.0.0-rc.14",
    "typescript": "catalog:"
  }
}
