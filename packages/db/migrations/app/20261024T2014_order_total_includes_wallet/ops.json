  {
    "id": "data_migration.recompute-order-totals",
    "label": "Recompute the order totals that left the wallet out",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "Check the Order table exists",
        "sql": "SELECT to_regclass('\"public\".\"Order\"') IS NOT NULL AS ok",
        "params": []
      }
    ],
    "execute": [
      {
        "description": "Recompute every order total that breaks the money identity",
        "sql": "UPDATE \"public\".\"Order\"\nSET \"totalCents\" = \"subtotalCents\" - \"discountCents\" + \"shippingCents\" - \"walletAppliedCents\"\nWHERE \"totalCents\" <> \"subtotalCents\" - \"discountCents\" + \"shippingCents\" - \"walletAppliedCents\"",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "Verify every order total matches the money identity",
        "sql": "SELECT NOT EXISTS (\n  SELECT 1\n  FROM \"public\".\"Order\"\n  WHERE \"totalCents\" <> \"subtotalCents\" - \"discountCents\" + \"shippingCents\" - \"walletAppliedCents\"\n) AS ok",
        "params": []
      }
    ]
  },
