      {
        "description": "add FK \"Domain_tenantId_fkey\"",
        "sql": "ALTER TABLE \"public\".\"Domain\"\nADD CONSTRAINT \"Domain_tenantId_fkey\"\nFOREIGN KEY (\"tenantId\")\nREFERENCES \"public\".\"Tenant\" (\"id\")\nON DELETE CASCADE\nON UPDATE CASCADE"
