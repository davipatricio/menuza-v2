{
  "name": "@menuza/api-commerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --filter '@menuza/commerce' dev",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "start": "bun --filter '@menuza/commerce' start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@menuza/orpc-server": "workspace:*",
    "@menuza/shared": "workspace:*",
    "@orpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
