# Copy this file to C:\Users\davip\.wslconfig
# This limits WSL2 memory and CPU usage to free resources for your apps.
#
# Place this at: C:\Users\davip\.wslconfig
# Then restart WSL2: wsl --shutdown
#
# After applying, WSL2 will use at most 4GB RAM and 4 CPUs.
# This frees ~4-8GB RAM and ~10-15% CPU for Brave/Orca/opencode.

[wsl2]
memory=4GB
processors=4
swap=0
localhostForwarding=true

# Optional: Fix TSC sync errors (Event ID 154)
# kernelCommandLine = "tsc=reliable"

# Default distribution (change to your distro name)
# default=Debian
