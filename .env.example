# Local development only. Real credentials must never be committed.

# Postgres (matches infra/compose.yaml)
DATABASE_URL="postgres://menuza:menuza@127.0.0.1:5433/menuza?schema=public"

# Redis (matches infra/compose.yaml)
REDIS_URL="redis://127.0.0.1:6379"

# API ports (loopback-bound)
COMMERCE_PORT=3001
TENANT_PORT=3002

# Internal API base URLs (server-side only; never expose to the browser)
COMMERCE_INTERNAL_URL="http://127.0.0.1:3001"
TENANT_INTERNAL_URL="http://127.0.0.1:3002"

# Public origin (server-side request base; Next resolves host via proxy.ts)
NEXT_PUBLIC_WEB_ORIGIN="http://127.0.0.1:3000"

# Local host routing: the main domain serves marketing + dashboard by path;
# tenant hosts serve the storefront. `WEB_HOST_MAP` keeps its `host=mode` CSV
# shape and only `storefront` entries take effect. See ADR-0005.

# Authoritative main-domain host. Marketing and dashboard are served here and
# nowhere else; an unknown host is denied (404). Development hosts are the only
# exception, and only outside production. Leave empty to deny every
# non-development host.
WEB_MAIN_DOMAIN="menuza.localhost"
WEB_STORE_DOMAIN_SUFFIX="localhost"
WEB_HOST_MAP="store.localhost=storefront"

# Trust proxy chain length for x-forwarded-* parsing when running behind a local reverse proxy.
TRUSTED_PROXY_HOPS=1
# Comma-separated trusted reverse-proxy IPs (e.g. "127.0.0.1,10.0.0.1"). While
# empty, x-forwarded-host is never honored, regardless of TRUSTED_PROXY_HOPS.
TRUSTED_PROXY_HOP_IPS=

# Sentry (optional). Leave SENTRY_DSN empty to disable Sentry entirely.
SENTRY_DSN=
# 10% of transactions are sampled by default; set to 0 to rely on OpenTelemetry tracing only.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENV=local

# Web (browser) Sentry DSN. Public by design: it ships inside the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time source map upload (CI/production only). An empty token disables
# upload and release creation; local builds stay offline.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# OpenTelemetry traces (optional). Points at the local Jaeger collector in
# infra/compose.yaml (UI: http://127.0.0.1:16686). Blank the endpoint to disable
# tracing entirely. Base collector URL: the exporter appends /v1/traces. Set
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT instead to point straight at the traces
# path. Standard OTEL_* vars are honoured; headers use "key=value,key=value".
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=