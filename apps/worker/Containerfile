# Worker image. Built via scripts/docker-build.ts (turbo prune --docker → tiny per-app context).
#   bun run scripts/docker-build.ts worker
# The compiled binary embeds the Bun runtime + bytecode; no node_modules ships.
FROM docker.io/oven/bun:1.4.2 AS build
WORKDIR /app

# json/: root manifest, pruned bun.lock, pruned workspace manifests.
COPY json/ ./
RUN bun install --frozen-lockfile

# full/: source of the pruned graph.
COPY full/ .
RUN cd apps/worker && bun run build

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home app
COPY --from=build /app/apps/worker/dist/worker /usr/local/bin/worker
USER app
CMD ["worker"]
