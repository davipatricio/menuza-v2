  "paths": {
    "/health": {
      "get": {
        "operationId": "getCommerceHealth",
        "summary": "Sonda de saúde do serviço de comércio.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "commerce"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente ou inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Unauthorized"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Operação não autorizada para esta sessão.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Forbidden"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Recurso não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/NotFound"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflito de estado.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Conflict"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Não foi possível identificar o tenant da requisição., Dados de entrada inválidos., Limite de requisições excedido., Erro interno inesperado., Entrada inválida.",
