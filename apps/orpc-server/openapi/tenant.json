    "/internal/resolve-host": {
      "get": {
        "operationId": "resolveTenantByStorefrontHost",
        "summary": "Resolve um host de storefront para o tenant correspondente (uso interno).",
        "tags": [
          "internal"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "host",
            "schema": {
