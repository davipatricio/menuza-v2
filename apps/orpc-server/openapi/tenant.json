                        "minLength": 1
                      },
                      "auth": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "p256dh",
                      "auth"
                    ],
                    "additionalProperties": false
                  },
                  "expirationTime": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
