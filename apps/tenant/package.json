{
  "name": "@menuza/tenant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "bun build --compile --bytecode --format=esm --minify --sourcemap src/server.ts --outfile dist/tenant",
    "dev": "bun --env-file-if-exists=../../.env --watch src/server.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "oauth:client": "bun --env-file-if-exists=../../.env src/oauth-client.ts",
    "start": "bun --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@menuza/api-tenant": "workspace:*",
    "@menuza/db": "workspace:*",
    "@menuza/orpc-server": "workspace:*",
    "@menuza/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@orpc/server": "catalog:",
    "@valibot/to-json-schema": "1.8.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
