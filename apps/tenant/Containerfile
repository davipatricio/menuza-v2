# Tenant (management) API image. Build context: repo root.
#   podman build -f apps/tenant/Containerfile -t menuza-tenant .
# The compiled binary embeds the Bun runtime and the Prisma generated client
# (regenerated here for the target platform); no node_modules ships.
FROM docker.io/oven/bun:1.4.2 AS build
WORKDIR /app

# Manifests first so `bun install` caches across source changes.
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY apps/commerce/package.json apps/commerce/
COPY apps/tenant/package.json apps/tenant/
COPY apps/worker/package.json apps/worker/
COPY apps/orpc-server/package.json apps/orpc-server/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/api-commerce/package.json packages/api-commerce/
COPY packages/api-tenant/package.json packages/api-tenant/
COPY packages/offline/package.json packages/offline/
RUN bun install --frozen-lockfile

COPY . .
RUN bun run db:generate
RUN cd apps/tenant && bun run build

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home app
COPY --from=build /app/apps/tenant/dist/tenant /usr/local/bin/tenant
USER app
ENV HOST=0.0.0.0 \
  TENANT_PORT=3002
EXPOSE 3002
CMD ["tenant"]
