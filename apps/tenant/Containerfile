# Tenant (management) API image. Built via scripts/docker-build.ts (turbo prune --docker).
# The compiled binary embeds the Bun runtime + bytecode and the Prisma
# generated client (regenerated here); no node_modules ships.
FROM docker.io/oven/bun:1.4.2 AS build
WORKDIR /app

# json/: root manifest, pruned bun.lock, pruned workspace manifests.
COPY json/ ./
RUN bun install --frozen-lockfile

# full/: source of the pruned graph.
COPY full/ .
RUN bun run --filter '@menuza/db' db:generate
RUN cd apps/tenant && bun run build

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home app
COPY --from=build /app/apps/tenant/dist/tenant /usr/local/bin/tenant
USER app
ENV HOST=0.0.0.0 \
  TENANT_PORT=3002
EXPOSE 3002
CMD ["tenant"]
