# Commerce API image. Built via scripts/docker-build.ts (turbo prune --docker).
#   bun run scripts/docker-build.ts commerce
# The compiled binary embeds the Bun runtime + bytecode and the Prisma
# generated client (regenerated here); no node_modules ships.
FROM docker.io/oven/bun:1.4.2 AS build
WORKDIR /app

# json/: root manifest, pruned bun.lock, pruned workspace manifests.
COPY json/ ./
RUN bun install --frozen-lockfile

# full/: source of the pruned graph.
COPY full/ .
RUN bun run --filter '@menuza/db' db:generate
RUN cd apps/commerce && bun run build

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home app
COPY --from=build /app/apps/commerce/dist/commerce /usr/local/bin/commerce
USER app
ENV HOST=0.0.0.0 \
  COMMERCE_PORT=3001
EXPOSE 3001
CMD ["commerce"]
