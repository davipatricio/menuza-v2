# Web (TanStack Start on Vite) image. Built via scripts/docker-build.ts
# (turbo prune --docker). The Vite build emits dist/client (assets + service
# worker) and dist/server/server.js, which Bun serves as the Start handler.
# Bun canary channel: there is no immutable 1.4.4 build; canary is the only resolvable pin.
FROM docker.io/oven/bun:canary AS build
WORKDIR /app

# json/: root manifest, pruned bun.lock, pruned workspace manifests.
COPY json/ ./
RUN bun install --frozen-lockfile

# full/: source of the pruned graph.
COPY full/ .
RUN bun run --filter '@menuza/web' typegen
RUN bun run --filter '@menuza/web' build

FROM docker.io/oven/bun:canary-slim
WORKDIR /app
USER bun
ENV NODE_ENV=production \
  HOST=0.0.0.0 \
  PORT=3000
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["bun", "apps/web/dist/server/server.js"]
