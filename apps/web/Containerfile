# Web (Next.js) image. Built via scripts/docker-build.ts (turbo prune --docker).
# Next standalone output runs on Bun. Type checking stays enabled.
FROM docker.io/oven/bun:1.4.2 AS build
WORKDIR /app

# json/: root manifest, pruned bun.lock, pruned workspace manifests.
COPY json/ ./
RUN bun install --frozen-lockfile

# full/: source of the pruned graph.
COPY full/ .
RUN bun run --filter '@menuza/web' typegen
RUN bun run --filter '@menuza/web' build

FROM docker.io/oven/bun:1.4.2-slim
WORKDIR /app
USER bun
ENV NODE_ENV=production \
  HOSTNAME=0.0.0.0 \
  PORT=3000
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["bun", "apps/web/server.js"]
