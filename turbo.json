{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "HOST",
    "COMMERCE_PORT",
    "TENANT_PORT",
    "COMMERCE_INTERNAL_URL",
    "TENANT_INTERNAL_URL",
    "INTERNAL_API_SECRET",
    "WEB_MAIN_DOMAIN",
    "WEB_HOST_MAP",
    "TRUSTED_PROXY_HOPS",
    "TRUSTED_PROXY_HOP_IPS",
    "VAPID_SUBJECT",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "NEXT_PUBLIC_BUILD_REVISION"
  ],
  "tasks": {
    // Per-workspace turbo.json overrides the outputs that differ (.next, prisma/generated).
    "build": {
      "dependsOn": ["^build", "db:generate", "typegen"],
      "outputs": ["dist/**"],
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_DSN",
        "SENTRY_ENV",
        "SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENV",
        "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE"
      ]
    },
    "typecheck": {
      "dependsOn": ["db:generate", "typegen"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "dependsOn": [],
      "outputs": []
    },
    "db:generate": {},
    "typegen": {
      "cache": false
    }
  }
}
