{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate", "typegen"],
      "outputs": ["$TURBO_ROOT$/apps/web/.next/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["db:generate", "typegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": ["$TURBO_ROOT$/packages/db/prisma/generated/**"]
    },
    "typegen": {
      "cache": false,
      "outputs": ["$TURBO_ROOT$/apps/web/.next/types/**"]
    }
  }
}
